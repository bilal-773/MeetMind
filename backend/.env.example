# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# AI APIs
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key            # For Whisper API mode
HUGGINGFACE_TOKEN=your-hf-token               # For PyAnnote model download

# Whisper
WHISPER_MODE=api                              # "local" or "api"
WHISPER_MODEL_SIZE=large-v3                   # tiny|base|small|medium|large-v2|large-v3

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Google OAuth (for Google Docs export)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# App
APP_ENV=development                           # development|production
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_FILE_SIZE_GB=10
